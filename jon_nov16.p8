--enemy #4 (xjyprv)
function ien4()
 ens4={}
 ens4.hp=4
 ens4.spr=15
 add(ens4,{x=64,y=64})
end

function uen4()
 for e4 in all(ens4) do
  local dir=move_towards(e4.x,e4.y,40,25,1)  e4.x+=dir.x
  e4.y+=dir.y
  for b in all(buls) do
   if abs(e4.x-b.x)<8 and abs(e4.y-b.y)<8 then
    ens4.hp-=1
    del(buls,b)
    sfx(5)
   if ens4.hp<=1 then
    ens4.spr=31
    sfx(6)
   if ens4.hp<=0 then
    del(ens4,e4)
    sfx(1)
    sfx(3)
    sc+=150
     end
    end
   end
  end
 end
end

function den4()
 for e4 in all(ens4) do
  spr(ens4.spr,e4.x,e4.y)
 end
end
-->8
--enemy #5 (golden iriz)
function create_gold(sx,sy,spd)
	gold={}
	gold.startx=sx
 gold.starty=sy
 gold.x=gold.startx
 gold.y=gold.starty
 gold.counter=0
 gold.speed=spd
 add(ens5,gold)
end

function ien5()
	ens5={}
 create_gold(60,60,0.03)
 create_gold(60,60,0.01)
end

function uen5()
 for e5 in all(ens5) do
 	e5.counter-=e5.speed
		e5.x=e5.startx+cos(e5.counter)*25
		e5.y=e5.starty+sin(e5.counter)*25
  for b in all(buls) do
   if abs(e5.x-b.x)<8 and abs(e5.y-b.y)<8 then
    del(ens5,e5)
    del(buls,b)
    sfx(1)
    sfx(4)
    sc+=500
   end
 	end
 end
end

function den5()
 for e5 in all(ens5) do
  spr(28,e5.x,e5.y)
 end
end
