pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--init--
function _init()
--ship
 p={
 sp=1,
 x=64,
 y=104
 }
--star
 starx={}
 stary={}
 speedstar={}
 for i=1,100 do
  add(starx,flr(rnd(128)))
  add(stary,flr(rnd(128)))
  add(speedstar,rnd(0.8)+0.5)
 end
--score & wave
 sc=0
 wa=0
--enemies
 ien() --iriz--
 ien2() --propell--
 ien3() --glee--
 ien4() --xjyprv--
 ien5() --golden iriz--
 ien6() --beast--
end
-->8
--update--
function _update()
--movement
 if btnp(➡️) then
 p.x+=8
 end
 if btnp(⬅️) then
 p.x-=8
 end
--1➡️2
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==4 then
 p.sp=2
 p.x=88
 p.y=16
 end
--3➡️4
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==6 then
 p.sp=1
 p.x=32
 p.y=104
 end
--3⬅️4
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==7 then
 p.sp=2
 p.x=32
 p.y=16
 end
--1⬅️2
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==5 then
 p.sp=1
 p.x=88
 p.y=104
 end
--animate stars
 starmove()
--enemies
 uen()
 uen2()
 uen3()
 uen4()
 uen5()
 uen6()
--bullet firing
	u_buls() 
end

-->8
--draw--
function _draw()
 cls()
 starfield()
 spr(138,64,64)
 den()
 den2()
 den3()
 den4()
 den5()
 den6()
 map()
 spr(p.sp,p.x,p.y)
 d_buls()
 print("score:"..sc,1,1,7)
 print("wave "..wa,100,1,7)
end
-->8
--starry background
function starfield()
 for i=1,#starx do
 local starclr=7
  if speedstar[i]<0.8 then
  starclr=1
  end
 pset(starx[i],stary[i],starclr)
 end
end

function starmove()
 for i=1,#starx do
  local sx=starx[i]
  sx=sx+speedstar[i]
  if sx>128 then
  sx=sx-128
  end
  starx[i]=sx
 end
end
-->8
--enemy #1 (iriz)
function ien()
 ens={}
 
 add(ens,{x=64,y=64})
end

function uen()
 for e in all(ens) do
  local dir=move_towards(e.x,e.y,64,25,0.5)
  e.x+=dir.x
  e.y+=dir.y
  for b in all(buls) do
   if abs(e.x-b.x)<8 and abs(e.y-b.y)<8 then
    del(ens,e)
    del(buls,b)
    sfx(1)
    sfx(2)
    sc+=100
   end
  end
 end
end

function den()
 for e in all(ens) do
  spr(12,e.x,e.y)
 end
end


function move_towards(x,y,tx,ty,spd)
 local dir=atan2(tx-x,ty-y)
 return {x=cos(dir)*spd,y=sin(dir)*spd}
end


-->8
--bullets
buls={}

function u_buls()
	--create new bullet
 if btnp(❎) then
 	--create new bullet
 	bul={
 		sp=17,
 		x=p.x,
 		y=96,
 		dy=0
		}
		--determine direction
		if p.y==104 then
	  bul.dy=-2
	  bul.y=p.y-8
	 else
	  bul.dy=2
	  bul.y=p.y+8
	 end
 	add(buls,bul)	
 	sfx(0)
 end
 --move all bullets
 for b in all(buls) do
 	b.y+=b.dy
 end
end

function d_buls()
	for b in all(buls) do
		spr(b.sp,b.x,b.y)
	end
end
