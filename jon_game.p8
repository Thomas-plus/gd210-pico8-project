__lua__
function _init()
 position=64
end


function _update()
 if btnp(➡️) then
 position+=8
 end
 if btnp(⬅️) then
 position-=8
 end
end


function _draw()
 cls(0)
 map()
 spr(1,position,64)
 print(button)
 print(mget(flr((position+5)/8),flr((64+5)/8)))
end
