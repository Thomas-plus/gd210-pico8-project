pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
--ship
 a=64
 a2=104
--bullet
 b=64
 b2=90
 ib()
--score
 c=0
--enemies
 ivc()
end

function _draw()
cls()
map()
spr(1,a,a2)
spr(4,b,b2)
db()
dvc()
print("score:"..c,0,1,7)
end

function _update()
ub()
uvc()
--movement
 if btnp(➡️) then
 a+=8
 end
 if btnp(⬅️) then
 a-=8
 end
--shooting
 if btnp(❎) then
  shoot()
  sfx(0)
 end
 
 b2=b2-5
end
-->8
--bullet firing--
function ib()
 bul={}
end

function ub()
 for b in all(bul) do
  b.y=b.y-1
  if b.x>128 then
   del(bul,b)
  end
 end
end

function db()
 for b in all(bul) do
  spr(4,b.x,b.y)
 end
end

function shoot()
 add(bul,{
 y=a2,
 x=a
 })
end
-->8
--vortex creature--

function ivc()
 vc={}
 
 add(vc,{x=64,y=64})
 add(vc,{x=32,y=80})
 add(vc,{x=54,y=30})
end

function uvc()
 for v in all(vc) do
  for b in all(bul) do
   if abs(v.x-b.x)<8 and abs(v.y-b.y)<8 then
    del(vc,v)
    c+=10
    sfx(1)
   end
  end
 end
end

function dvc()
 for v in all(vc) do
 	spr(17,v.x,v.y)
 end
end
