pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--init--
function _init()
--ship
 p={
 sp=1,
 x=64,
 y=104
 }
--star
 starx={}
 stary={}
 speedstar={}
 for i=1,100 do
  add(starx,flr(rnd(128)))
  add(stary,flr(rnd(128)))
  add(speedstar,rnd(0.8)+0.5)
 end
--score & wave
 sc=0
 wa=0
--enemies
 ien()
end
-->8
--update--
function _update()
--movement
 if btnp(➡️) then
 p.x+=8
 end
 if btnp(⬅️) then
 p.x-=8
 end
--1➡️2
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==4 then
 p.sp=2
 p.x=88
 p.y=16
 end
--3➡️4
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==6 then
 p.sp=1
 p.x=32
 p.y=104
 end
--3⬅️4
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==7 then
 p.sp=2
 p.x=32
 p.y=16
 end
--1⬅️2
 if mget(flr((p.x+4)/8),flr((p.y+4)/8))==5 then
 p.sp=1
 p.x=88
 p.y=104
 end
--animate stars
 starmove()
--enemies
 uen()
--bullet firing
	u_buls() 
end
-->8
--draw--
function _draw()
 cls()
 starfield()
 den()
 map()
 spr(p.sp,p.x,p.y)
 d_buls()
 print("score:"..sc,1,1,7)
 print("wave "..wa,100,1,7)
end
-->8
--starry background
function starfield()
 for i=1,#starx do
 local starclr=7
  if speedstar[i]<0.8 then
  starclr=1
  end
 pset(starx[i],stary[i],starclr)
 end
end

function starmove()
 for i=1,#starx do
  local sx=starx[i]
  sx=sx+speedstar[i]
  if sx>128 then
  sx=sx-128
  end
  starx[i]=sx
 end
end
-->8
--enemies
function ien()
 ens={}
 
 add(ens,{x=64,y=70})
 add(ens,{x=40,y=80})
 add(ens,{x=75,y=80})
 add(ens,{x=50,y=30})
end

function uen()
 for e in all(ens) do
  for b in all(buls) do
   if abs(e.x-b.x)<8 and abs(e.y-b.y)<8 then
    del(ens,e)
    del(buls,b)
   end
  end
 end
end

function den()
 for e in all(ens) do
  spr(12,e.x,e.y)
 end
end

-->8
--bullets
buls={}

function u_buls()
	--create new bullet
 if btnp(❎) then
 	--create new bullet
 	bul={
 		sp=17,
 		x=p.x,
 		y=96,
 		dy=0
		}
		--determine direction
		if p.y==104 then
	  bul.dy=-2
	  bul.y=p.y-8
	 else
	  bul.dy=2
	  bul.y=p.y+8
	 end
 	add(buls,bul)	
 	sfx(0)
 end
 --move all bullets
 for b in all(buls) do
 	b.y+=b.dy
 end
end

function d_buls()
	for b in all(buls) do
		spr(b.sp,b.x,b.y)
	end
end
