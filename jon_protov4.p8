pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--init--
function _init()
--ship
 a=1
 a2=64
 a3=104
--star
 starx={}
 stary={}
 speedstar={}
 for i=1,100 do
  add(starx,flr(rnd(128)))
  add(stary,flr(rnd(128)))
  add(speedstar,rnd(0.8)+0.5)
 end
--bullet (up)
 b=17
 b2=64
 b3=96
--bullet (down)
 c=18
 c2=64
 c3=24
end
-->8
--update--
function _update()
--movement
 if btnp(➡️) then
 a2+=8
 end
 if btnp(⬅️) then
 a2-=8
 end
--1➡️2
 if mget(flr((a2+4)/8),flr((a3+4)/8))==4 then
 a=2
 a2=88
 a3=16
 end
--3➡️4
 if mget(flr((a2+4)/8),flr((a3+4)/8))==6 then
 a=1
 a2=32
 a3=104
 end
--3⬅️4
 if mget(flr((a2+4)/8),flr((a3+4)/8))==7 then
 a=2
 a2=32
 a3=16
 end
--1⬅️2
 if mget(flr((a2+4)/8),flr((a3+4)/8))==5 then
 a=1
 a2=88
 a3=104
 end
--animate stars
 starmove()
--shooting
 if btnp(❎) then
 upbullet()
 end
end
-->8
--draw--
function _draw()
 cls()
 starfield()
 map()
 spr(a,a2,a3)
 spr(b,b2,b3)
-- spr(c,c2,c3)
 print("score:"..0,1,1,7)
 print("wave "..0,100,1,7)
 
end
-->8
--starry background
function starfield()
 for i=1,#starx do
 local starclr=7
  if speedstar[i]<0.8 then
  starclr=1
  end
 pset(starx[i],stary[i],starclr)
 end
end

function starmove()
 for i=1,#starx do
  local sx=starx[i]
  sx=sx+speedstar[i]
  if sx>128 then
  sx=sx-128
  end
  starx[i]=sx
 end
end
-->8
--bullet position
function upbullet()
 b3=a3-3
 b2=a2
 sfx(0)
end

function downbullet()
 c3=a3-3
 c2=a2
 sfx(0)
end
