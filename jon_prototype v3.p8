pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--init--
function _init()
--ship
 a=1
 a2=64
 a3=104
--star
 starx={}
 stary={}
 for i=1,100 do
  add(starx,flr(rnd(128)))
  add(stary,flr(rnd(128)))
 end
end
-->8
--update--
function _update()
--movement
 if btnp(➡️) then
 a2+=8
 end
 if btnp(⬅️) then
 a2-=8
 end
--1➡️2
 if mget(flr((a2+4)/8),flr((a3+4)/8))==4 then
 a=2
 a2=88
 a3=16
 end
--3➡️4
 if mget(flr((a2+4)/8),flr((a3+4)/8))==6 then
 a=1
 a2=32
 a3=104
 end
--3⬅️4
 if mget(flr((a2+4)/8),flr((a3+4)/8))==7 then
 a=2
 a2=32
 a3=16
 end
--1⬅️2
 if mget(flr((a2+4)/8),flr((a3+4)/8))==5 then
 a=1
 a2=88
 a3=104
 end
end
-->8
--draw--
function _draw()
 cls()
 starfield()
 map()
 spr(a,a2,a3)
 
end
-->8
--starry background
function starfield()
 for i=1,#starx do
 pset(starx[i],stary[i],7)
 end
end
