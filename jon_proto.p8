pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
--ship
 a=64
 a2=104
--bullet
 b=64
 b2=90
--score
 c=0
 
end

function _draw()
cls()
map()
spr(1,a,a2)
spr(4,b,b2)

print("score:"..c,0,1,7)
end

function _update()
--movement
 if btnp(➡️) then
 a+=8
 end
 if btnp(⬅️) then
 a-=8
 end
--shooting
 if btnp(❎) then
  b2=a2-6
  b=a
  c+=5
  sfx(0)
 end
 
 b2=b2-5
end
